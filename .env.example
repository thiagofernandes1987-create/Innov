NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

SIGNATURE_PROVIDER=sandbox
SIGNATURE_WEBHOOK_SECRET=

# Reservadas para provedores externos ainda não integrados. Nenhum código da
# plataforma lê estas variáveis hoje; não provisione segredos reais até que a
# integração correspondente exista.
SIGNATURE_CLICK_SIGN_API_KEY=
SIGNATURE_ZAPSIGN_API_KEY=
SIGNATURE_DOCUSIGN_INTEGRATION_KEY=

# Worker DOCX → PDF. O host precisa ter LibreOffice instalado.
SIGNATURE_SOFFICE_BIN=soffice
SIGNATURE_CONVERSION_WORKER_ID=

# Entrega de cópia por e-mail via webhook HMAC.
SIGNATURE_DELIVERY_WORKER_ID=
SIGNATURE_EMAIL_WEBHOOK_URL=
SIGNATURE_EMAIL_WEBHOOK_SECRET=

ALLOW_INSECURE_DEMO_USERS=false
DEMO_ADMIN_EMAIL=admin@innov.eng.br
DEMO_ADMIN_PASSWORD=
DEMO_CLIENT_EMAIL=cliente@cliente.com
DEMO_CLIENT_PASSWORD=

# Etapa 20 — backup e restauração em ambiente isolado.
SUPABASE_DB_URL=
SUPABASE_RESTORE_DB_URL=
SUPABASE_RESTORE_CONFIRMATION=

# Etapa 20 — quarentena e análise antimalware de anexos.
# Produção/Vercel: gateway HTTPS gratuito hospedado separadamente.
FILE_SECURITY_PROVIDER=clamav-http
FILE_SECURITY_SCANNER_URL=https://scanner.seudominio.com.br
FILE_SECURITY_SCANNER_SECRET=
FILE_SECURITY_QUARANTINE_BUCKET=file-quarantine
CLAMAV_TIMEOUT_MS=15000
ALLOW_INSECURE_FILE_SCANNER=false

# Somente para desenvolvimento local ou runtime na mesma rede privada do clamd.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Aplicação: protege a rota HTTPS interna de saúde do scanner.
FILE_SECURITY_HEALTH_SECRET=

# GitHub environment homologation: URL pública HTTPS da aplicação, não do clamd.
HOMOLOGATION_APP_URL=
FILE_SECURITY_HEALTH_TIMEOUT_MS=30000
VERCEL_AUTOMATION_BYPASS_SECRET=

# Etapa 22 — WhatsApp Business Platform (Cloud API).
# Nunca versionar token, segredo do aplicativo ou token de verificação.
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Homologação real usando exclusivamente o número temporário/sandbox da Meta.
# Não reutilizar phone_number_id ou destinatário do número comercial.
# O smoke test falha fechado sem as duas confirmações booleanas abaixo.
WHATSAPP_TEST_MODE=false
WHATSAPP_TEST_SEND_ENABLED=false
WHATSAPP_TEST_PHONE_NUMBER_ID=
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_TEST_TEMPLATE_NAME=hello_world
WHATSAPP_TEST_TEMPLATE_LANGUAGE=en_US

# Etapa 22/W-03 — flags de provider por organização.
# JSON inválido desabilita o provider em modo fail-closed.
# Providers sem runtime registrado continuam desabilitados mesmo quando requestedEnabled=true.
# Exemplo:
# {"<organization-uuid>":{"META_CLOUD":{"enabled":true,"disabledCapabilities":["MESSAGE_SEND_TEXT"]},"WHATSAPP_WEB_BAILEYS":{"enabled":false}}}
MESSAGING_PROVIDER_FLAGS_JSON={}

# Etapa 22 — geração de rascunhos por IA na central de bots.
# OPENAI_API_KEY deve permanecer exclusivamente no cofre do ambiente.
# O modelo e os custos são explícitos para impedir estimativas financeiras silenciosas.
# Custos em micros por 1.000.000 de tokens; revise quando o modelo ou a tabela de preços mudar.
OPENAI_API_KEY=
OPENAI_MESSAGING_MODEL=
OPENAI_MESSAGING_INPUT_COST_MICROS_PER_MILLION=
OPENAI_MESSAGING_OUTPUT_COST_MICROS_PER_MILLION=

# ---------------------------------------------------------------------------
# RH/DP — eSocial. Nenhuma destas variáveis estava declarada em lugar nenhum
# até a auditoria de 10/08/2026: o código do RH as lê em runtime e o operador
# não tinha como saber que existiam. Certificado e chave nunca são versionados.
# ---------------------------------------------------------------------------

# Fail-closed: só o literal "true" libera o ambiente PRODUCTION. Qualquer outro
# valor (inclusive ausente) mantém o envio preso em Produção Restrita.
ESOCIAL_ENABLE_PRODUCTION=false

# mTLS — duas formas mutuamente exclusivas. Ou o PFX em base64 com a senha,
# ou o par PEM. Nos PEM, quebras de linha podem vir escapadas como \n.
ESOCIAL_CERTIFICATE_PFX_BASE64=
ESOCIAL_CERTIFICATE_PASSPHRASE=
ESOCIAL_CERTIFICATE_PEM=
ESOCIAL_PRIVATE_KEY_PEM=

# Assinatura XML. Quando vazias, caem para o par de mTLS acima — o que é
# aceitável em homologação e deve ser explícito em produção.
ESOCIAL_SIGNING_CERTIFICATE_PEM=
ESOCIAL_SIGNING_PRIVATE_KEY_PEM=

# Transmissor do lote. Tipo 1 = CNPJ, 2 = CPF; qualquer valor diferente de 2 é
# lido como 1. O número é reduzido a dígitos.
ESOCIAL_TRANSMITTER_REGISTRATION_TYPE=1
ESOCIAL_TRANSMITTER_REGISTRATION_NUMBER=

# Versões de namespace e SOAPAction do pacote oficial. Os valores abaixo são os
# defaults embutidos no código; mudam quando o eSocial publica pacote novo.
ESOCIAL_BATCH_NAMESPACE_VERSION=v1_1_1
ESOCIAL_QUERY_NAMESPACE_VERSION=v1_0_0
ESOCIAL_SEND_SOAP_ACTION=default-package-v1.6
ESOCIAL_QUERY_SOAP_ACTION=official-package-v1.6

# Identificação do software emissor gravada em verProc de cada evento.
ESOCIAL_PROCESS_VERSION=Innovar-RH/0.1

# ---------------------------------------------------------------------------
# RH/DP — Integra Contador (SERPRO), usado na DCTFWeb. Pendência externa
# declarada: sem contrato e sem Consumer Key, o ponto de entrada existe e não
# é chamado. As URLs abaixo são os defaults do código.
# ---------------------------------------------------------------------------
INTEGRA_CONTADOR_ENABLE_PRODUCTION=false
INTEGRA_CONTADOR_BASE_URL=https://gateway.apiserpro.serpro.gov.br
INTEGRA_CONTADOR_VALIDATION_BASE_URL=https://gateway-val.apiserpro.serpro.gov.br
INTEGRA_CONTADOR_CONSUMER_KEY=
INTEGRA_CONTADOR_CONSUMER_SECRET=
INTEGRA_CONTADOR_DCTFWEB_EVENTS_PATH=
INTEGRA_CONTADOR_DCTFWEB_SERVICE_PATH=
# Fora da faixa de 1000 a 120000 ms, o código volta para 20000.
INTEGRA_CONTADOR_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# SINAPI — rotas internas de diagnóstico da fonte oficial da Caixa.
# O token protege /api/internal/sinapi-source-probe e sinapi-leitura-real.
# Menos de 32 caracteres reprova a autorização: a rota fica fechada.
# ---------------------------------------------------------------------------
SINAPI_PROBE_TOKEN=

# ---------------------------------------------------------------------------
# Laboratório Baileys — WhatsApp Web não oficial, descartável e fora de
# produção. Sem a confirmação literal abaixo, o laboratório não sobe.
# ---------------------------------------------------------------------------
BAILEYS_LAB_CONFIRM=
BAILEYS_LAB_EVIDENCE_PATH=
BAILEYS_LAB_QR_MODULE=
# Fora da faixa de 60000 a 900000 ms, o código volta para 480000.
BAILEYS_LAB_TIMEOUT_MS=480000
