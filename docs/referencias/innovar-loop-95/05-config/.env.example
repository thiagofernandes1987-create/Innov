NODE_ENV=development
PORT=3000
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_SECRET
DATABASE_URL=postgresql://innovar:REPLACE_WITH_LOCAL_SECRET@postgres:5432/innovar
REDIS_URL=redis://redis:6379
DEFAULT_LOCALE=pt-BR
DEFAULT_TIMEZONE=America/Sao_Paulo
DEFAULT_CURRENCY=BRL
STORAGE_STRATEGY=JSONB_HYBRID
FEATURE_METADATA_OBJECTS=true
FEATURE_SOLUTION_PACKAGING=false
WORKER_MAX_CONCURRENCY=10
WORKER_MAX_ATTEMPTS=5
WORKER_RETRY_BASE_SECONDS=2
WORKER_RETRY_MAX_SECONDS=300
IDEMPOTENCY_TTL_SECONDS=604800
IDEMPOTENCY_LOCK_SECONDS=60
METADATA_CACHE_TTL_SECONDS=60
API_MAX_PAGE_SIZE=200
LOG_LEVEL=info

# Object Definitions
OBJECT_DEFINITION_MAX_FIELDS=250
OBJECT_SCHEMA_MAX_BYTES=1048576
OBJECT_PUBLISH_REQUIRE_REVIEW=true
OBJECT_BREAKING_CHANGE_POLICY=DENY

# Required only for the signed trusted-proxy reference runtime. Never commit a real value.
TRUSTED_PROXY_CONTEXT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
