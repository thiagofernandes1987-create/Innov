APP_ENV=development
SERVICE_NAME=innovar-event-admin
SERVICE_REVISION=dev
DATABASE_URL=postgresql://innovar:change-me@postgres:5432/innovar
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_LOCK_TIMEOUT_MS=2000
TENANT_CONTEXT_REQUIRED=true
REDPANDA_BROKERS=redpanda:9092
REDPANDA_TOPIC_PREFIX=innovar
REDPANDA_SECURITY_PROTOCOL=PLAINTEXT
OUTBOX_BATCH_SIZE=100
OUTBOX_LEASE_SECONDS=30
OUTBOX_MAX_ATTEMPTS=20
OUTBOX_RETRY_BASE_MS=500
OUTBOX_RETRY_MAX_MS=60000
DLQ_RETENTION_DAYS=30
EVIDENCE_DIR=/var/lib/innovar/evidence
EVIDENCE_CAMPAIGN_ID=execution-evidence
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
LOG_LEVEL=INFO
