{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://innovar.local/schemas/error-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "errors"
  ],
  "properties": {
    "errors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "retryable"
        ],
        "properties": {
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "retryable": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
