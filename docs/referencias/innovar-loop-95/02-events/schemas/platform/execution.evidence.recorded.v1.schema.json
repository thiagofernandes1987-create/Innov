{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidenceId",
    "campaignId",
    "gateKey",
    "status",
    "observedAt"
  ],
  "properties": {
    "evidenceId": {
      "type": "string",
      "format": "uuid"
    },
    "campaignId": {
      "type": "string"
    },
    "gateKey": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "artifactSha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
