{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.innovar.app/events/metadata.object.created.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_definition_id",
    "namespace",
    "object_key",
    "storage_strategy",
    "retention_class"
  ],
  "properties": {
    "object_definition_id": {
      "type": "string",
      "format": "uuid"
    },
    "namespace": {
      "type": "string"
    },
    "object_key": {
      "type": "string"
    },
    "storage_strategy": {
      "type": "string",
      "enum": [
        "JSONB_HYBRID"
      ]
    },
    "retention_class": {
      "type": "string"
    }
  }
}
