{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.innovar.app/commands/create-record.command.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_key",
    "values"
  ],
  "properties": {
    "object_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,119}$"
    },
    "values": {
      "type": "object"
    }
  }
}
