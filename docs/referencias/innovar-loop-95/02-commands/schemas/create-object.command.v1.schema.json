{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.innovar.app/commands/create-object.command.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace",
    "object_key",
    "singular_name",
    "plural_name",
    "retention_class"
  ],
  "properties": {
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
    },
    "object_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,119}$"
    },
    "singular_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "plural_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "retention_class": {
      "type": "string",
      "enum": [
        "OPERATIONAL",
        "FINANCIAL",
        "LEGAL",
        "AUDIT",
        "MARKETING",
        "TEMPORARY",
        "SENSITIVE"
      ]
    }
  }
}
