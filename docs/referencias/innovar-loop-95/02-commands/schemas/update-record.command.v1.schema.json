{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.innovar.app/commands/update-record.command.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "expected_version",
    "values"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "format": "uuid"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1
    },
    "values": {
      "type": "object"
    }
  }
}
