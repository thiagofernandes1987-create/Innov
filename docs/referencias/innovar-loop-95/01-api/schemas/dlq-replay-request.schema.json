{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reason",
    "mode"
  ],
  "properties": {
    "reason": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "mode": {
      "type": "string",
      "enum": [
        "SINGLE",
        "BATCH"
      ]
    },
    "dry_run": {
      "type": "boolean",
      "default": true
    }
  }
}