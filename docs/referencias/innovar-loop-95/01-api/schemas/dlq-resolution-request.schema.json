{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resolution",
    "note"
  ],
  "properties": {
    "resolution": {
      "type": "string",
      "enum": [
        "REPLAYED",
        "DISCARDED",
        "SUPERSEDED"
      ]
    },
    "note": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000
    }
  }
}